{
  "name": "registration-and-certificate-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "ระบบลงทะเบียน ออกเกียรติบัตร และประเมินความพึงพอใจ (Registration, Certificate & Evaluation System)",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:generate": "pnpm --filter api prisma generate",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:studio": "pnpm --filter api prisma studio"
  },
  "keywords": [
    "registration",
    "certificate",
    "evaluation",
    "thai-sarabun"
  ],
