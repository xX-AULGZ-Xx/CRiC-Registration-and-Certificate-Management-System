# Git & Version Control
.git
.gitignore

# Dependencies & Package Managers
node_modules
.pnpm-store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js Build Outputs
.next
out

# TypeScript Build Outputs
dist
build

# Storage files (except placeholders)
storage/certificates/*
!storage/certificates/.gitkeep
storage/signatures/*
!storage/signatures/.gitkeep
storage/logos/*
!storage/logos/.gitkeep

# Environment local files
.env.local
.env.*.local

# Operating System
.DS_Store
Thumbs.db
